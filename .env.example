# ===================================================
# Edamos Barbershop - Environment Variables Template
# ===================================================
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi PostgreSQL lokal/server Anda:
#   cp .env.example .env
#
# JANGAN PERNAH memasukkan file .env yang berisi password asli ke Git/GitHub.

# Format URL PostgreSQL:
# postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Contoh:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edamos_barbershop?schema=public"
DATABASE_URL="postgresql://postgres:password_anda@localhost:5432/edamos_barbershop?schema=public"

# Node Environment (development | production)
NODE_ENV="development"

# Next.js Port (default: 3000)
PORT=3000
