// ===================================================
// Prisma Schema - Edamos Barbershop
// Sistem Informasi Reservasi Online dan Penggajian Karyawan
// ===================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------
// ENUMS
// ---------------------------------------------------

enum Role {
  OWNER
  ADMIN
  KAPSTER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

// ---------------------------------------------------
// MASTER TABLES
// ---------------------------------------------------

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  email     String?   @unique
  password  String
  role      Role      @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employee  Employee?

  @@map("users")
}

model Employee {
  id              String         @id @default(cuid())
  userId          String?        @unique
  name            String
  phone           String?
  role            Role           @default(KAPSTER)
  status          EmployeeStatus @default(ACTIVE)
  baseSalary      Decimal        @default(0) @db.Decimal(12, 2)
  commissionRate  Decimal        @default(0) @db.Decimal(5, 2) // persentase komisi jika ada
  hiredAt         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings        Booking[]      @relation("KapsterBookings")
  transactions    Transaction[]  @relation("AdminTransactions")
  performances    PerformanceRecord[]
  payrollDetails  PayrollDetail[]

  @@map("employees")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@map("customers")
}

model Service {
  id              String        @id @default(cuid())
  name            String
  category        String?
  price           Decimal       @db.Decimal(12, 2)
  durationMinutes Int           @default(30)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookingItems    BookingItem[]

  @@map("services")
}

// ---------------------------------------------------
// TRANSACTION TABLES
// ---------------------------------------------------

model Booking {
  id                String         @id @default(cuid())
  bookingCode       String         @unique
  customerId        String
  kapsterId         String
  bookingDate       DateTime       @db.Date
  startTime         String         // Format: "10:00"
  endTime           String         // Format: "10:45"
  scheduledAt       DateTime       // DateTime lengkap untuk validasi bentrok jadwal
  status            BookingStatus  @default(PENDING)
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kapster           Employee       @relation("KapsterBookings", fields: [kapsterId], references: [id], onDelete: Restrict)
  items             BookingItem[]
  transaction       Transaction?
  performanceRecord PerformanceRecord?

  @@index([kapsterId, bookingDate])
  @@index([scheduledAt])
  @@map("bookings")
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  serviceId String
  price     Decimal  @db.Decimal(12, 2)
  notes     String?

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_items")
}

model Transaction {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  bookingId     String?       @unique
  adminId       String?
  customerName  String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  paidAt        DateTime?     @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  admin         Employee?     @relation("AdminTransactions", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("transactions")
}

model PerformanceRecord {
  id               String    @id @default(cuid())
  employeeId       String
  bookingId        String?   @unique
  serviceDate      DateTime  @db.Date
  serviceName      String
  serviceFee       Decimal   @db.Decimal(12, 2)
  commissionAmount Decimal   @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime  @default(now())

  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  booking          Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([employeeId, serviceDate])
  @@map("performance_records")
}

model OperationalExpense {
  id          String    @id @default(cuid())
  expenseName String
  category    String    @default("OPERASIONAL") // LISTRIK, AIR, PERLENGKAPAN, LAINNYA
  amount      Decimal   @db.Decimal(12, 2)
  expenseDate DateTime  @db.Date
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expenseDate])
  @@map("operational_expenses")
}

// ---------------------------------------------------
// PAYROLL TABLES
// ---------------------------------------------------

model Payroll {
  id            String         @id @default(cuid())
  payrollPeriod String         // Contoh: "2026-10" atau "Oktober 2026"
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  totalRevenue  Decimal        @db.Decimal(12, 2)
  totalExpenses Decimal        @db.Decimal(12, 2)
  grossProfit   Decimal        @db.Decimal(12, 2) // Revenue - Expenses
  salaryPool    Decimal        @db.Decimal(12, 2) // Alokasi dana gaji (e.g. 50% dari laba kotor)
  totalNetPaid  Decimal        @default(0) @db.Decimal(12, 2)
  status        PayrollStatus  @default(DRAFT)
  approvedAt    DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  details       PayrollDetail[]

  @@unique([payrollPeriod])
  @@map("payrolls")
}

model PayrollDetail {
  id                    String        @id @default(cuid())
  payrollId             String
  employeeId            String
  slipNumber            String        @unique // Contoh: "SLIP-202610-001"
  employeeName          String
  employeeRole          Role
  totalServicesServed   Int           @default(0)
  baseSalary            Decimal       @default(0) @db.Decimal(12, 2)
  performanceCommission Decimal       @default(0) @db.Decimal(12, 2)
  bonus                 Decimal       @default(0) @db.Decimal(12, 2)
  deductions            Decimal       @default(0) @db.Decimal(12, 2)
  netSalary             Decimal       @db.Decimal(12, 2)
  paymentStatus         PaymentStatus @default(UNPAID)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  payroll               Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_details")
}
